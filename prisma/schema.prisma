generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  externalId  String?  @unique

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  name        String
  description String?
  unit        String?

  priceWithoutVat Int?
  priceWithVat    Float?
  price           String?

  packageType     String?
  packageQuantity Int?
  packageUnit     String?

  photo       String?

  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  selectedBy  ClientSelectedProduct[]
}

model Client {
  id          String   @id @default(cuid())

  name        String
  city        String
  phone       String

  source      String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  createdAt   DateTime @default(now())

  selectedProducts ClientSelectedProduct[]
}

model ClientSelectedProduct {
  id                  String   @id @default(cuid())

  clientId            String
  client              Client   @relation(fields: [clientId], references: [id])

  productId           String?
  product             Product? @relation(fields: [productId], references: [id])

  productNameSnapshot String

  createdAt           DateTime @default(now())
}

model AppSettings {
  id                 String   @id @default("default")

  companyName        String   @default("Каталог хозтоваров")
  catalogTitle       String   @default("Каталог хозтоваров")
  catalogDescription String?

  whatsappPhone      String?
  showPrices         Boolean  @default(true)
  showVatPrices      Boolean  @default(true)

  updatedAt          DateTime @updatedAt
}
