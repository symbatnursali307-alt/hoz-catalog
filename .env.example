# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Writable image storage used by the VPS deployment.
UPLOAD_DIR="/srv/katalog-hoz/shared/uploads"

# Legacy recovery/import scripts may still use Vercel Blob.
BLOB_READ_WRITE_TOKEN=""

# Admin area credentials. Always generate new values for the VPS.
ADMIN_LOGIN=""
ADMIN_PASSWORD=""
# Optional second full-access administrator account.
ADMIN_ADDITIONAL_LOGIN=""
ADMIN_ADDITIONAL_PASSWORD=""
ADMIN_SECRET=""

# Orders are always saved. Set to true and restart the app to show them in admin.
ADMIN_ORDERS_VISIBLE="false"

# Fallback WhatsApp number until manager routing is implemented.
WHATSAPP_PHONE=""

# Temporary checkout switch. False/empty opens WhatsApp directly from the cart.
# Set to true and restart the app to restore the customer name/phone step.
CART_CONTACT_STEP_ENABLED="false"

# Public canonical URL and privacy-safe analytics hashing salt.
SITE_URL="https://catalog.almatytovar.kz"
ANALYTICS_SALT=""

# Optional Meta integrations. They remain disabled while these values are empty.
NEXT_PUBLIC_META_PIXEL_ID=""
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
META_GRAPH_API_VERSION=""
META_TEST_EVENT_CODE=""
